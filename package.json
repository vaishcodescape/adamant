{
  "name": "adamant",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing codebase AI agent for developers",
  "license": "MIT",
  "author": "Aditya Vaish",
  "main": "electron/main/dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @adamant/shared typecheck && pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --parallel test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:dir": "pnpm build && electron-builder --config electron-builder.yml --dir",
    "clean": "rm -rf release electron/*/dist electron/*/*.tsbuildinfo",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
