# Worker image. Same backend package as the API, different entrypoint.
FROM node:22.12-bookworm-slim AS deps

RUN npm install -g pnpm@10

WORKDIR /app

# Frozen install checks every workspace importer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY server/package.json server/package.json
COPY electron/adamant/package.json electron/adamant/package.json
COPY electron/main/package.json electron/main/package.json
COPY electron/preload/package.json electron/preload/package.json
COPY electron/shared/package.json electron/shared/package.json

RUN pnpm install --frozen-lockfile --filter @adamant/server --prod --ignore-scripts

FROM node:22.12-bookworm-slim AS runner

ENV NODE_ENV=production

# The agent shells out to git for the per-run worktree and to the docker CLI to
# start one sandbox container per candidate. Both are allowlisted adapters, not
# a shell the model can reach.
RUN apt-get update \
  && apt-get install --no-install-recommends -y git ca-certificates docker.io \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY server/package.json server/package.json
COPY server/worker server/worker
COPY server/agent server/agent
COPY server/sandbox server/sandbox
COPY server/db server/db

WORKDIR /app/server

USER node

CMD ["node", "--experimental-strip-types", "worker/index.ts"]
